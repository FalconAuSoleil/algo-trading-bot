# ═══════════════════════════════════════════════════════════════════════════
# Algo Trading Bot — full configuration reference
# ═══════════════════════════════════════════════════════════════════════════
# Every tunable parameter in the code reads its value from here via _envf /
# _envi lookups in src/config.py. Defaults in code match the values below
# so removing a line falls back to the documented behaviour.
#
# Kelly-related constants are intentionally kept hardcoded in the engines
# (kelly * 0.25 / 0.20 / 0.22) — DO NOT add them here without a code refactor.
# ═══════════════════════════════════════════════════════════════════════════


# ─── Runtime ──────────────────────────────────────────────────────────────
TRADING_MODE=paper                   # "paper" | "live"
PAPER_INITIAL_BALANCE=10000          # USDC seed capital in paper mode

# ─── Polymarket credentials (live only) ───────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_PRIVATE_KEY=

# Polygon RPC for on-chain reads/redemption (drpc default is rate-limited)
POLYGON_RPC=https://polygon.drpc.org


# ═══════════════════════════════════════════════════════════════════════════
# SIGNAL THRESHOLDS (shared by all strategies)
# ═══════════════════════════════════════════════════════════════════════════
EDGE_MIN=0.06                        # minimum edge (p_true - entry - fee) to fire
EDGE_MAX=0.15                        # reject suspicious-edge signals above this
MIN_TRUE_PROB=0.56                   # confidence floor on p_true
MAX_BET_FRACTION=0.04                # hard cap on % of balance per bet
MIN_MARKET_PROB_SIDE=0.35            # skip longshots (market price too low)
MAX_MARKET_PROB_SIDE=0.70            # skip overpriced sides
MIN_MARKET_LIQUIDITY=15.0            # min CLOB depth (USD) on both sides

# ─── Timing windows — 5-minute markets ────────────────────────────────────
TIME_MIN_5M=75                       # don't enter if T_remaining < this (s)
TIME_MAX_5M=120                      # don't enter if T_remaining > this (s)
TIME_MAX_5M_ACCUM=150                # ACCUM phase ceiling — stability warmup

# ─── Timing windows — 15-minute markets ───────────────────────────────────
TIME_MIN_15M=60
TIME_MAX_15M=300

# ─── Chainlink oracle lag arbitrage ───────────────────────────────────────
CHAINLINK_PERIOD=27.0                # expected CL update interval (s)
CHAINLINK_EDGE_WINDOW=8.0            # lookahead window before next CL tick
ORACLE_FRESHNESS_MAX_AGE_SEC=55.0    # reject if last CL tick older than this

# ─── Microstructure building blocks ───────────────────────────────────────
OFI_WEIGHT=0.20                      # weight of order-flow imbalance in logit
KYLE_SPREAD_PENALTY=0.15             # Kyle lambda spread-penalty coefficient
HAWKES_MU=0.1                        # Hawkes baseline intensity
HAWKES_ALPHA=0.8                     # Hawkes excitation magnitude
HAWKES_BETA=2.0                      # Hawkes decay rate
HAWKES_HISTORY=200                   # event buffer length

# ─── Momentum + fallback thresholds ───────────────────────────────────────
MOMENTUM_FACTOR=80.0                 # logit scaling of delta in ChainlinkArb
MOMENTUM_MIN_THRESHOLD=0.0008        # _MomentumEngine: min |return| over window
MEAN_REV_DELTA_THRESHOLD=0.0020      # _MeanReversionEngine: delta to fade

# ─── Delta / vol floors (global + 5m multiplier) ──────────────────────────
DELTA_MIN_ABS=0.0010                 # global absolute delta floor
DELTA_MIN_ABS_5M_MULT=1.5            # 5m markets × this multiplier (noisier)
DELTA_MIN=0.0012                     # legacy delta floor (kept for compat)
VOLATILITY_MAX=0.0015                # cap on realized vol before trading
VOLATILITY_WINDOW_MINUTES=30         # window for vol baseline estimation
SOURCE_COHERENCE_MAX=0.005           # max Binance↔Chainlink divergence

# ─── Fee model ────────────────────────────────────────────────────────────
FEE_RATE=0.02                        # Polymarket taker fee: 2% × (1-p)

# ─── Stability filter (all strategies) ────────────────────────────────────
STABILITY_WINDOW_SEC=45.0            # lookback for edge stability check
STABILITY_MIN_SAMPLES=5              # min observations before betting
STABILITY_MIN_RATIO=0.75             # % of samples on same side required
STABILITY_EDGE_CV_MAX=1.0            # max coefficient of variation on edge


# ═══════════════════════════════════════════════════════════════════════════
# _ChainlinkArbEngine internals (exposed v4.3 for swarm optimization)
# ═══════════════════════════════════════════════════════════════════════════
MOMENTUM_SHORT_WINDOW_SEC=15.0       # short-horizon momentum window inside CL arb
MOMENTUM_INNER_WEIGHT=0.2            # weight of short-momentum in the logit
MOMENTUM_NORMALIZER=0.002            # normalizes raw return before clamp
CHAINLINK_BOOST_GAIN=1500.0          # gain on CL lag edge boost
CHAINLINK_BOOST_CLAMP=1.5            # ±clamp on the boost magnitude
VOL_WINDOW_CHAINLINK_SEC=300.0       # realized vol lookback window
ORACLE_AGE_PENALTY_WEIGHT=0.5        # t_eff = t_rem + age × this
MIN_VIABLE_DELTA_SIGMA_MULT=1.0      # min_viable_delta = K · σ · √t_eff
BLEND_WEIGHT_MIN=0.15                # min blend weight Bayesian↔Diffusion
BLEND_WEIGHT_MAX=0.55                # max blend weight
OVERPAYING_MARGIN=0.02               # reject if prob < entry + this
HAWKES_WEAK_THRESHOLD_MULT=1.5       # if intensity < μ × this → size penalty
HAWKES_WEAK_SIZE_MULT=0.7            # size × this when Hawkes is weak
DEPTH_SIZE_CAP_RATIO=0.3             # cap order size at depth × this
MIN_TRADE_SIZE_USD=1.0               # don't submit orders below this
CONFIDENCE_HIGH_SCORE=0.10           # composite confidence threshold HIGH
CONFIDENCE_MED_SCORE=0.06            # composite confidence threshold MED


# ═══════════════════════════════════════════════════════════════════════════
# _MomentumEngine internals
# ═══════════════════════════════════════════════════════════════════════════
MOMENTUM_TIME_MIN=60.0               # fire only if T_remaining ≥ this (s)
MOMENTUM_TIME_MAX=150.0              # fire only if T_remaining ≤ this (s)
MOMENTUM_WINDOW_SHORT_SEC=60.0       # short-term return window
MOMENTUM_WINDOW_MID_SEC=120.0        # mid-term confirmation window
MOMENTUM_WINDOW_LONG_SEC=240.0       # long-term confirmation window (v4.2)
MOMENTUM_DIRECTION_MIN_DELTA=0.0005  # required delta alignment with direction
MOMENTUM_PDIFF_MIN=0.60              # diffusion p_true floor to accept
MOMENTUM_PBAYES_FLOOR=0.53           # Bayesian p_true lower bound
MOMENTUM_PBAYES_CEIL=0.67            # Bayesian p_true upper bound
MOMENTUM_STRENGTH_MULT=20.0          # maps momentum_strength → Δ p_bayes
MOMENTUM_BLEND_MIN=0.2               # diffusion blend lower bound
MOMENTUM_BLEND_MAX=0.45              # diffusion blend upper bound
MOMENTUM_EDGE_MIN_MULT=0.9           # edge_min × this (momentum accepts a bit less)
MOMENTUM_SIZE_MULT=0.5               # max_bet_fraction × this for momentum bets


# ═══════════════════════════════════════════════════════════════════════════
# _MeanReversionEngine internals
# ═══════════════════════════════════════════════════════════════════════════
MEANREV_TIME_MIN=90.0                # fire only if T_remaining ≥ this (s)
MEANREV_TIME_MAX=180.0               # fire only if T_remaining ≤ this (s)
MEANREV_MAX_CONSEC_LOSSES=2          # skip mean_rev after N consecutive losses
MEANREV_SIGMA_BOOST=1.5              # sigma_fallback × this for fade check
MEANREV_SIGMA_THRESHOLD_MULT=1.5     # require |delta| ≥ this × one_sigma
MEANREV_PTRUE_FLOOR=0.52             # p_true lower bound for contrarian bets
MEANREV_PTRUE_CEIL=0.62              # p_true upper bound
MEANREV_PTRUE_MULT=8.0               # maps excess delta → p_true
MEANREV_SIZE_MULT=0.4                # max_bet_fraction × this for mean_rev


# ═══════════════════════════════════════════════════════════════════════════
# _BTCStabilizationEngine internals (BTC 15m late-entry strategy)
# ═══════════════════════════════════════════════════════════════════════════
BTC_STAB_PRICE_MIN=0.58              # low end of stabilization zone
BTC_STAB_PRICE_MAX=0.85              # high end of stabilization zone
BTC_STAB_TIME_MIN=45.0               # fire only if T_remaining ≥ this (s)
BTC_STAB_TIME_MAX=300.0              # fire only if T_remaining ≤ this (s)
BTC_STAB_WINDOW_SEC=20.0             # stability lookback window
BTC_STAB_MAX_SWING=0.08              # max absolute price swing during window
BTC_STAB_MIN_OBS=3                   # min observations to assess stability
BTC_STAB_EDGE_MIN=0.020              # edge floor for this strategy
BTC_STAB_MAX_BET=0.035               # hard size cap for this strategy
BTC_STAB_VOL_WINDOW_SEC=600.0        # realized vol window (longer than CL arb)
BTC_STAB_SIGMA_BAND_MULT=2.0         # dynamic swing = N · σ · √window · 100
BTC_STAB_MIN_SWING_FLOOR=0.03        # floor under dynamic swing (3¢)
BTC_STAB_IMBALANCE_PENALTY_TH=0.5    # penalize p_diff if opp depth imbalance > this
BTC_STAB_IMBALANCE_PENALTY_MAG=0.02  # magnitude of the penalty (× imbalance)
BTC_STAB_IMBALANCE_BOOST_TH=-0.3     # boost p_diff if opp depth imbalance < this
BTC_STAB_IMBALANCE_BOOST_MAG=0.01    # magnitude of the boost (flat)
BTC_STAB_DEPTH_CAP_RATIO=0.25        # cap size at depth × this (btc_stab only)


# ═══════════════════════════════════════════════════════════════════════════
# Peak-hours gate (disabled by default since v4.1.1)
# ═══════════════════════════════════════════════════════════════════════════
PEAK_HOURS_ENABLED=false             # true → ETH/SOL/XRP + BTC5m limited to peak
PEAK_START_HOUR_ET=8                 # peak window start (US Eastern time)
PEAK_END_HOUR_ET=18                  # peak window end

# Off-peak adaptive mode (always on — tightens filters at night/weekends)
OFFPEAK_EDGE_MULT=1.3                # edge_min × this when off-peak
OFFPEAK_SIZING_MULT=0.6              # bet size × this when off-peak


# ═══════════════════════════════════════════════════════════════════════════
# Early exit (v5) — sell before resolution if signal decays
# ═══════════════════════════════════════════════════════════════════════════
EARLY_EXIT_ENABLED=true
EARLY_EXIT_MIN_T_REM=30.0            # never sell in the last N seconds
EARLY_EXIT_P_FLOOR=0.35              # mode A: sell if p_true drops below this
EARLY_EXIT_P_DROP=0.50               # mode A: sell if p_true drops >50% from entry
EARLY_EXIT_MIN_BID=0.05              # need at least this best_bid to sell
EARLY_EXIT_DELTA_EROSION=0.60        # mode B: delta lost ≥60% of entry value
EARLY_EXIT_DELTA_FLOOR=0.0015        # mode B: delta now below absolute floor
EARLY_EXIT_EROSION_ELAPSED=0.70      # mode B: only after 70% of market elapsed


# ═══════════════════════════════════════════════════════════════════════════
# Staged entry (v5) — split bet into 85/15 and top up on dips
# ═══════════════════════════════════════════════════════════════════════════
STAGED_ENTRY_ENABLED=true
STAGED_INITIAL_FRAC=0.85             # % deployed immediately
STAGED_TOPUP_FRAC=0.15               # % reserved for potential dip entry
STAGED_MIN_CONFIDENCE=0.70           # p_true floor to enable staged mode
STAGED_DIP_THRESHOLD=0.08            # absolute price drop that triggers top-up
STAGED_TOPUP_MIN_P=0.55              # need p_true ≥ this at top-up time
STAGED_TOPUP_MIN_T=60.0              # need at least this T_remaining (s)


# ═══════════════════════════════════════════════════════════════════════════
# RISK MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════
KELLY_FRACTION=0.25                  # Kelly scaling (note: engines use hardcoded
                                     # inner kelly × 0.25/0.20 — see config.py)
MAX_POSITION_PCT=0.05                # per-position cap (% of balance)
MAX_DAILY_DRAWDOWN=0.06              # halt if daily drawdown exceeds this
MAX_CONSECUTIVE_LOSSES=3             # circuit breaker on loss streak
MAX_OPEN_POSITIONS=4                 # hard cap on concurrent positions
MAX_DAILY_RISK=0.12                  # max capital-at-risk per day


# ─── Dashboard / infra ────────────────────────────────────────────────────
DASHBOARD_PORT=8080
DASHBOARD_HOST=0.0.0.0
DB_PATH=data/trades.db
LOG_LEVEL=INFO
